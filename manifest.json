{
  "manifest_version": 3,
  "name": "YouTube Jump Ahead",
  "version": "1.0",
  "description": "Adds a context menu item to jump ahead in YouTube videos.",
  "permissions": [
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}